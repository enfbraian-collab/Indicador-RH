table 'public dim_situacao_apuracao'
	lineageTag: 6f04f171-ce7c-4456-8083-e00c296a835d

	column id_situacao_apuracao
		dataType: int64
		formatString: 0
		lineageTag: f32b52e3-12fd-440f-9b56-b3c4b74c2d1b
		summarizeBy: none
		sourceColumn: id_situacao_apuracao

		annotation SummarizationSetBy = Automatic

	column 'Periodo Apuracao' =
			
			IF(
			    CONTAINSSTRING(
			        LOWER('public dim_situacao_apuracao'[descricao_situacao]),
			        "noturno"
			    ),
			    "Noturno",
			    "Diurno"
			)
		lineageTag: dd8476e1-2427-4ad3-b0c7-81a9bd5321bc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column descricao_situacao
