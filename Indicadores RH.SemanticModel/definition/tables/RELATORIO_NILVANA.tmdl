	partition RELATORIO_NILVANA = m
		mode: import
		source =
				let
				
				    Fonte = Csv.Document(
				        Web.Contents(
				            "https://docs.google.com/spreadsheets/d/e/2PACX-1vTppzv11fNkbjEP_lAhRQ0XS4C3LgEJZRPoAG_gCF4pamHqDVLow29_DW0ZiwwzT5Mdz89N0L-u-hdU/pub?output=csv"
				        ),
				        [
				            Delimiter = ",",
				            Columns = 19,
				            Encoding = 65001,
				            QuoteStyle = QuoteStyle.None
				        ]
				    ),
				
				    #"Cabeçalhos Promovidos" =
				        Table.PromoteHeaders(
				            Fonte,
				            [PromoteAllScalars = true]
				        ),
				
				    #"Tipo Alterado" =
				        Table.TransformColumnTypes(
				            #"Cabeçalhos Promovidos",
				            {
				                {"COD EMPRESA", Int64.Type},
				                {"EMPRESA", type text},
				                {"COD COL", Int64.Type},
				                {"CRACHA", Int64.Type},
				                {"NOME ", type text},
				                {"INICIO COMPETENCIA", type date},
				                {"FIM COMPENTENCIA", type date},
				                {"COD CONTRATO", Int64.Type},
				                {"DATA DE ADIMISSÃO ", type date},
				                {"SITUAÇÃO", type text},
				                {"DATA DEMISSÃO", type text},
				                {"COD DO CARGO", Int64.Type},
				                {"CARGO", type text},
				                {"CATEGORIA", type text},
				                {"COD CENTRO DE CUSTO", Int64.Type},
				                {"DESCRIÇÃO CENTRO DE CISTO", type text},
				                {"COD LOCAL", Int64.Type},
				                {"DESCRIÇÃO LOCAL ", type text}
				            }
				        ),
				
				    #"SK Colaborador Adicionado" =
				        Table.AddColumn(
				            #"Tipo Alterado",
				            "sk_colaborador",
				            each
				                Text.From([COD EMPRESA]) & "-" &
				                Text.From([COD COL]) & "-" &
				                Text.From([CRACHA]),
				            type text
				        ),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"SK Colaborador Adicionado",{{"DATA DEMISSÃO", type date}}),
				    #"Erros Substituídos" = Table.ReplaceErrorValues(#"Tipo Alterado1", {{"DATA DEMISSÃO", null}})
				
				in
				
				    #"Erros Substituídos"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

