table RELATORIO_NILVANA
	lineageTag: 02a4319f-6459-4187-8106-28b867bff0fd

	measure '4Admissões Nilvana' =
			
			VAR DataInicial =
			    MIN('public.dCalendario'[Date])
			
			VAR DataFinal =
			    MAX('public.dCalendario'[Date])
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('RELATORIO_NILVANA'[sk_colaborador]),
			
			    REMOVEFILTERS('public.dCalendario'),
			
			    FILTER(
			        'RELATORIO_NILVANA',
			
			        'RELATORIO_NILVANA'[DATA DE ADIMISSÃO ] >= DataInicial
			            &&
			        'RELATORIO_NILVANA'[DATA DE ADIMISSÃO ] <= DataFinal
			
			            &&
			
			        NOT(
			            'RELATORIO_NILVANA'[DATA DEMISSÃO] >= DataInicial
			                &&
			            'RELATORIO_NILVANA'[DATA DEMISSÃO] <= DataFinal
			        )
			    ),
			
			    'RELATORIO_NILVANA'[COD EMPRESA] = 1,
			    'RELATORIO_NILVANA'[COD CONTRATO] = 1
			)
		formatString: 0
		lineageTag: b4d0ae4e-1d16-409a-941e-e657c1218557

	measure '4Demissoes Nilvana' =
			
			VAR DataInicial =
			    MIN('public.dCalendario'[Date])
			
			VAR DataFinal =
			    MAX('public.dCalendario'[Date])
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('RELATORIO_NILVANA'[sk_colaborador]),
			
			    REMOVEFILTERS('public.dCalendario'),
			
			    FILTER(
			        'RELATORIO_NILVANA',
			        NOT(ISBLANK('RELATORIO_NILVANA'[DATA DEMISSÃO]))
			            &&
			        'RELATORIO_NILVANA'[DATA DEMISSÃO] >= DataInicial
			            &&
			        'RELATORIO_NILVANA'[DATA DEMISSÃO] <= DataFinal
			    ),
			
			    'RELATORIO_NILVANA'[COD EMPRESA] = 1
			)
		formatString: 0
		lineageTag: 2017e474-f08c-4a83-a214-2dd7f4688f3c

	measure '4Ativos Competência4' =
			
			VAR DataFinal =
			    MAX('public.dCalendario'[Date])
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('RELATORIO_NILVANA'[sk_colaborador]),
			
			    REMOVEFILTERS('public.dCalendario'),
			
			    FILTER(
			        'RELATORIO_NILVANA',
			
			        'RELATORIO_NILVANA'[DATA DE ADIMISSÃO ] <= DataFinal
			            &&
			        (
			            ISBLANK('RELATORIO_NILVANA'[DATA DEMISSÃO])
			                ||
			            'RELATORIO_NILVANA'[DATA DEMISSÃO] > DataFinal
			        )
			    ),
			
			    'RELATORIO_NILVANA'[COD EMPRESA] = 1,
			    'RELATORIO_NILVANA'[COD CONTRATO] = 1
			)
		formatString: 0
		lineageTag: e563392a-63fb-4d9f-ba65-ff602addb49e

	measure '4Saldo Final Colaboradores Nilvana' =
			
			VAR DataSelecionada =
			    MAX('public.dCalendario'[Date])
			
			VAR PeriodoAtual =
			    DATE(
			        YEAR(DataSelecionada),
			        MONTH(DataSelecionada),
			        1
			    )
			
			VAR PrimeiroPeriodo =
			    CALCULATE(
			        MIN('RELATORIO_NILVANA'[INICIO COMPETENCIA]),
			
			        REMOVEFILTERS(
			            'RELATORIO_NILVANA'[INICIO COMPETENCIA],
			            'RELATORIO_NILVANA'[FIM COMPENTENCIA],
			            'RELATORIO_NILVANA'[STATUS]
			        ),
			
			        'RELATORIO_NILVANA'[STATUS] <> "Demitido no mesmo mês"
			    )
			
			VAR AtivosInicial =
			    CALCULATE(
			        DISTINCTCOUNT('RELATORIO_NILVANA'[sk_colaborador]),
			
			        REMOVEFILTERS(
			            'RELATORIO_NILVANA'[INICIO COMPETENCIA],
			            'RELATORIO_NILVANA'[FIM COMPENTENCIA],
			            'RELATORIO_NILVANA'[STATUS]
			        ),
			
			        FILTER(
			            'RELATORIO_NILVANA',
			
			            'RELATORIO_NILVANA'[INICIO COMPETENCIA] = PrimeiroPeriodo
			                &&
			            UPPER(TRIM('RELATORIO_NILVANA'[STATUS])) = "ATIVO"
			                &&
			            UPPER(TRIM('RELATORIO_NILVANA'[STATUS])) <> "DEMITIDO NO MESMO MÊS"
			        )
			    )
			
			VAR AdmissoesAcumuladas =
			    CALCULATE(
			        DISTINCTCOUNT('RELATORIO_NILVANA'[sk_colaborador]),
			
			        REMOVEFILTERS(
			            'RELATORIO_NILVANA'[INICIO COMPETENCIA],
			            'RELATORIO_NILVANA'[FIM COMPENTENCIA],
			            'RELATORIO_NILVANA'[STATUS]
			        ),
			
			        FILTER(
			            'RELATORIO_NILVANA',
			
			            'RELATORIO_NILVANA'[INICIO COMPETENCIA] >= PrimeiroPeriodo
			                &&
			            'RELATORIO_NILVANA'[INICIO COMPETENCIA] < PeriodoAtual
			                &&
			            CONTAINSSTRING(
			                UPPER(TRIM('RELATORIO_NILVANA'[STATUS])),
			                "ADMISS"
			            )
			                &&
			            UPPER(TRIM('RELATORIO_NILVANA'[STATUS])) <> "DEMITIDO NO MESMO MÊS"
			        )
			    )
			
			VAR DemissoesAcumuladas =
			    CALCULATE(
			        DISTINCTCOUNT('RELATORIO_NILVANA'[sk_colaborador]),
			
			        REMOVEFILTERS(
			            'RELATORIO_NILVANA'[INICIO COMPETENCIA],
			            'RELATORIO_NILVANA'[FIM COMPENTENCIA],
			            'RELATORIO_NILVANA'[STATUS]
			        ),
			
			        FILTER(
			            'RELATORIO_NILVANA',
			
			            'RELATORIO_NILVANA'[INICIO COMPETENCIA] > PrimeiroPeriodo
			                &&
			            'RELATORIO_NILVANA'[INICIO COMPETENCIA] <= PeriodoAtual
			                &&
			            CONTAINSSTRING(
			                UPPER(TRIM('RELATORIO_NILVANA'[STATUS])),
			                "DEMISS"
			            )
			                &&
			            UPPER(TRIM('RELATORIO_NILVANA'[STATUS])) <> "DEMITIDO NO MESMO MÊS"
			        )
			    )
			
			RETURN
			    AtivosInicial
			        + AdmissoesAcumuladas
			        - DemissoesAcumuladas
		formatString: 0
		lineageTag: 043c4897-620f-453b-9de4-642c4dedb53e

	measure '4Admissões Mês Anterior Nilvana' =
			
			VAR MesesVisiveis =
			    DISTINCT(
			        SELECTCOLUMNS(
			            'public.dCalendario',
			            "MesReferencia",
			                DATE(
			                    YEAR('public.dCalendario'[Date]),
			                    MONTH('public.dCalendario'[Date]),
			                    1
			                )
			        )
			    )
			
			RETURN
			SUMX(
			    MesesVisiveis,
			
			    VAR DataAtual =
			        [MesReferencia]
			
			    VAR InicioMesAnterior =
			        EOMONTH(DataAtual, -2) + 1
			
			    VAR FimMesAnterior =
			        EOMONTH(DataAtual, -1)
			
			    RETURN
			        CALCULATE(
			            DISTINCTCOUNT('RELATORIO_NILVANA'[sk_colaborador]),
			
			            REMOVEFILTERS('public.dCalendario'),
			
			            FILTER(
			                'RELATORIO_NILVANA',
			
			                'RELATORIO_NILVANA'[INICIO COMPETENCIA] >= InicioMesAnterior
			                    &&
			                'RELATORIO_NILVANA'[INICIO COMPETENCIA] <= FimMesAnterior
			                    &&
			                CONTAINSSTRING(
			                    UPPER(TRIM('RELATORIO_NILVANA'[STATUS])),
			                    "ADMISS"
			                )
			            )
			        )
			)
		formatString: 0
		lineageTag: 97043222-e579-4cbd-a064-feb2dbfb91b0

