	column 'Classe Afastamento > 15 dias' =
			
			VAR Situacao = 'public fato_apuracao'[id_situacao_apuracao]
			
			RETURN
			IF(
			    Situacao IN {
			        3, 6, 4, 19, 23, 53, 54, 56, 17, 108, 110, 120
			    },
			    "Afastamento > 15 dias",
			    "Outros"
			)
		lineageTag: a0a6e4f8-9937-4325-a772-4e922bb41096
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Classe Absenteísmo' =
			
			VAR Situacao = 'public fato_apuracao'[id_situacao_apuracao]
			
			RETURN
			IF(
			    Situacao IN {
			        15, 65, 135, 308, 337, 338, 150, 18, 68, 405, 415, 86, 87,
			        14, 74, 11, 61, 30, 31, 46, 47, 309, 34, 35, 20, 21, 57,
			        100, 219, 263, 208, 241, 242, 141, 144, 5, 55, 77, 115,
			        184, 279, 81, 85, 142, 143, 231, 232, 233, 234, 235, 236,
			        237, 238, 22, 342, 343, 345, 357,
			        3, 6, 4, 19, 23, 53, 54, 56, 17, 108, 110, 120
			    },
			    "Absenteísmo",
			    "Não Absenteísmo"
			)
		lineageTag: b9580258-f734-4f9e-a0a7-0b512869372b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

