table 'public fato_apuracao'
	lineageTag: c09012f7-414e-40f3-aba7-c9fdaf821b51

	measure '4Horas Absenteismo' =
			
			DIVIDE(
			    SUMX(
			        SUMMARIZE(
			            FILTER(
			                'public fato_apuracao',
			                'public fato_apuracao'[flag_absenteismo] = "Sim"
			                    && 'public fato_apuracao'[id_cod_empresa] IN {1,2,5}
			                    && 'public fato_apuracao'[id_tipo_colaborador] IN {1,2}
			                    && 'public fato_apuracao'[data_apuracao] >= DATE(2025,1,1)
			            ),
			            'public fato_apuracao'[sk_colaborador],
			            'public fato_apuracao'[data_apuracao],
			            'public fato_apuracao'[id_situacao_apuracao],
			            'public fato_apuracao'[quantidade_horas_minutos]
			        ),
			        'public fato_apuracao'[quantidade_horas_minutos]
			    ),
			    60,
			    0
			)
		lineageTag: c93c0402-29bc-4e55-8029-74d1b63ce823

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '1Horas Trabalhadas' = ```
			
			DIVIDE(
			    CALCULATE(
			        SUM('public fato_apuracao'[quantidade_horas_minutos]),
			        'public fato_apuracao'[flag_absenteismo] = "Não",
			        'public fato_apuracao'[id_cod_empresa] = 1,
			        'public fato_apuracao'[id_tipo_colaborador] =1 ,
			        'public.dCalendario'[date] >= DATE(2025, 1, 1)
			    ),
			    2,
			    0
			)
			
			```
		lineageTag: 353f9948-9b7e-47dc-a64a-d905f7358817

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '1Horas Previstas semanas' = ```
			
			DIVIDE(
			    MAX('public dim_escala'[horas_prevista_semana]),
			    60
			)
			
			```
		lineageTag: 10750826-3702-4c40-bb54-0966a9835a5c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '1Diferença Horas medida' =
			
			[1Horas Trabalhadas] - [1Horas Previstas semanas 1]
		lineageTag: 12167953-2e13-4001-ada5-8dcf9b0a927b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '1Diferença Horas Formatada' =
			
			VAR MinutosTotais =
			    ROUND([1Diferença Horas medida] * 60, 0)
			VAR Sinal =
			    IF(MinutosTotais > 0, "+", IF(MinutosTotais < 0, "-", ""))
			VAR MinutosAbsolutos =
			    ABS(MinutosTotais)
			VAR Horas =
			    QUOTIENT(MinutosAbsolutos, 60)
			VAR Minutos =
			    MOD(MinutosAbsolutos, 60)
			RETURN
			    Sinal
			        & Horas
			        & "h "
			        & FORMAT(Minutos, "00")
			        & "m"
		lineageTag: 89b9b72f-a344-42f7-a25b-c51d5dfef3a4

	measure '1Taxa Absenteísmo' =
			
			DIVIDE(
			    [4Horas Absenteismo],
			    [1Horas Previstas semanas 1],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c83dd250-c416-40cb-a7d5-6d7c54706da3

	measure '1Horas Previstas1' =
			
			DIVIDE(
			    MAX('public dim_escala'[horas_prevista_semana]),
			    60
			)
		lineageTag: de311d22-c06e-4187-8619-453d335553e1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '4Diferença Horas medida mês' =
			
			[3Horas Trabalhadas Líquidas] - [4Horas Previstas Pessoa Mês]
		lineageTag: 01638ac1-d978-492f-a82e-eba7f1a3526b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '4Diferença Horas Formatada mês' =
			
			VAR MinutosTotais =
			    ROUND([4Diferença Horas medida mês] * 60, 0)
			VAR Sinal =
			    IF(MinutosTotais > 0, "+", IF(MinutosTotais < 0, "-", ""))
			VAR MinutosAbsolutos =
			    ABS(MinutosTotais)
			VAR Horas =
			    QUOTIENT(MinutosAbsolutos, 60)
			VAR Minutos =
			    MOD(MinutosAbsolutos, 60)
			RETURN
			    Sinal
			        & Horas
			        & "h "
			        & FORMAT(Minutos, "00")
			        & "m"
		lineageTag: 2667600d-f16f-48fc-88a6-f7f7f9bb2c79

	measure '2Taxa Absenteísmo mês' =
			
			DIVIDE(
			    [4Horas Absenteismo],
			    [2Horas Previstas mês3],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b730df85-22d0-4c68-9c65-3ba27cec6b63

	measure '2Horas Previstas mês3' =
			
			VAR CodigoEscalaAtual =
			    SELECTEDVALUE('public fato_apuracao'[codigo_escala])
			
			VAR MinutosPrevistos =
			    LOOKUPVALUE(
			        'public dim_escala'[total_hora_mes],
			        'public dim_escala'[codigo_escala],
			        CodigoEscalaAtual
			    )
			
			RETURN
			    DIVIDE(MinutosPrevistos, 60)
		lineageTag: a278f865-3860-46b5-9af2-4929f1acd096

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '2Horas Previstas mês' =
			
			DIVIDE(
			    SELECTEDVALUE(
			        'public dim_escala'[total_hora_mes]
			    ),
			    60
			)
		lineageTag: 4500e587-ada2-4507-91c2-11b3aeae6d62

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '1Horas Previstas semanas 1' =
			
			VAR CodigoEscalaAtual =
			    SELECTEDVALUE('public fato_apuracao'[codigo_escala])
			
			VAR MinutosPrevistos =
			    LOOKUPVALUE(
			        'public dim_escala'[horas_prevista_semana],
			        'public dim_escala'[codigo_escala],
			        CodigoEscalaAtual
			    )
			
			RETURN
			    DIVIDE(MinutosPrevistos, 60)
		lineageTag: 29b56f4c-d853-4d28-93af-354144b4152d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '4Salário Base Mensal' =
			
			SUMX(
			    SUMMARIZE(
			        'public fato_apuracao',
			        'public fato_apuracao'[cracha],
			        'public.dCalendario'[AnoMes],
			        "SalarioMes",
			            CALCULATE(
			                MAX('public fato_apuracao'[salario_base])
			            )
			    ),
			    [SalarioMes]
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: ec320743-5762-4841-9363-db6546d7982e

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '4Horas Previstas Pessoa Mês' = VAR ColaboradoresMes = CALCULATETABLE( SUMMARIZE( 'public fato_apuracao', 'public fato_apuracao'[sk_colaborador], 'public.dCalendario'[AnoMes] ), 'public fato_apuracao'[id_cod_empresa] IN { 1, 2, 5 }, 'public fato_apuracao'[id_tipo_colaborador] IN { 1, 2 }, 'public.dCalendario'[date] >= DATE(2025, 1, 1), REMOVEFILTERS( 'public fato_apuracao'[flag_absenteismo] ), REMOVEFILTERS( 'public dim_situacao_apuracao' ) ) RETURN SUMX( ColaboradoresMes, VAR MinutosPrevistos = CALCULATE( MAXX( 'public fato_apuracao', RELATED( 'public dim_escala'[total_hora_mes] ) ), 'public fato_apuracao'[id_cod_empresa] IN { 1, 2, 5 }, 'public fato_apuracao'[id_tipo_colaborador] IN { 1, 2 }, REMOVEFILTERS( 'public fato_apuracao'[flag_absenteismo] ), REMOVEFILTERS( 'public dim_situacao_apuracao' ) ) RETURN DIVIDE(MinutosPrevistos, 60, 0) )
		lineageTag: 7fa5abae-9357-4d4d-89ac-35fa79f49b2e

	measure '4Horas Trabalhadas Líquidas' =
			
			VAR BaseSemDuplicidade =
			    FILTER(
			        SUMMARIZE(
			            'public fato_apuracao',
			            'public fato_apuracao'[data_apuracao],
			            'public fato_apuracao'[sk_colaborador],
			            'public fato_apuracao'[cracha],
			            'public fato_apuracao'[flag_absenteismo],
			            'public fato_apuracao'[id_situacao_apuracao],
			            'public dim_situacao_apuracao'[descricao_situacao],
			            'public fato_apuracao'[quantidade_horas_minutos],
			            'public fato_apuracao'[codigo_escala]
			        ),
			        'public fato_apuracao'[id_situacao_apuracao] <> 28
			    )
			
			VAR TotalMinutos =
			    SUMX(
			        BaseSemDuplicidade,
			        VAR Minutos =
			            'public fato_apuracao'[quantidade_horas_minutos]
			
			        VAR Sinal =
			            IF(
			                'public fato_apuracao'[flag_absenteismo] = "Sim",
			                -1,
			                1
			            )
			
			        RETURN
			            Minutos * Sinal
			    )
			
			RETURN
			    DIVIDE(TotalMinutos, 60, 0)
		lineageTag: 14caedd3-6f74-4e5b-91e4-ef20f3b981c7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '4Horas Compensação' =
			
			VAR BaseSemDuplicidade =
			    FILTER(
			        SUMMARIZE(
			            'public fato_apuracao',
			            'public fato_apuracao'[data_apuracao],
			            'public fato_apuracao'[sk_colaborador],
			            'public fato_apuracao'[cracha],
			            'public fato_apuracao'[id_situacao_apuracao],
			            'public fato_apuracao'[quantidade_horas_minutos],
			            'public fato_apuracao'[codigo_escala]
			        ),
			        'public fato_apuracao'[id_situacao_apuracao] = 28
			    )
			
			VAR TotalMinutos =
			    SUMX(
			        BaseSemDuplicidade,
			        'public fato_apuracao'[quantidade_horas_minutos]
			    )
			
			RETURN
			    DIVIDE(TotalMinutos, 60, 0)
		lineageTag: 039d6526-751e-4f0b-b855-116163f5922f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '4Horas Compensação Formatada' =
			
			VAR HorasDecimais =
			    [4Horas Compensação]
			
			VAR TotalMinutos =
			    ROUND(HorasDecimais * 60, 0)
			
			VAR Horas =
			    QUOTIENT(TotalMinutos, 60)
			
			VAR Minutos =
			    MOD(TotalMinutos, 60)
			
			RETURN
			    FORMAT(Horas, "0")
			        & "h "
			        & FORMAT(Minutos, "00")
			        & "min"
		lineageTag: 1116820c-cc6e-4afe-8d86-bf8db9194087

	measure '4Taxa Absenteísmo mês' =
			
