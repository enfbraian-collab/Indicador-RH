	hierarchy 'data_admissao Hierarquia'
		lineageTag: 9d33ece4-5c48-4836-a25e-c957ab67606e

		level data_admissao
			lineageTag: 40d029fc-3af8-44a0-aef7-018cc07a86cd
			column: data_admissao

	partition 'public dim_colaborador' = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database("10.10.10.22", "rh_40"),
				    public_dim_colaborador = Fonte{[Schema="public", Item="dim_colaborador"]}[Data],
				
				    // ============================================================
				    // 1. Remove duplicidades por crachá
				    // ============================================================
				    #"Duplicatas Removidas" =
				        Table.Distinct(
				            public_dim_colaborador,
				            {"cracha"}
				        ),
				
				    // ============================================================
				    // 2. Lista dos tipos que queremos aplicar
				    // ============================================================
				    TiposDesejados = {
				        {"cracha", Int64.Type},
				        {"cpf", Int64.Type},
				        {"data_nascimento", type date},
				        {"data_admissao", type date},
				        {"data_demissao", type date},
				        {"id_tipo_contrato", Int64.Type},
				        {"id_estado_cv", Int64.Type},
				        {"id_raca", Int64.Type},
				        {"id_tipo_colaborador", Int64.Type},
				        {"id_cod_filial", Int64.Type},
				        {"id_cod_empresa", Int64.Type},
				        {"id_situacao", Int64.Type},
				        {"id_cargo", Int64.Type},
				        {"data_inicio_cargo", type date},
				        {"data_fim_cargo", type date},
				        {"id_centro_custo", Int64.Type},
				        {"data_inicio_cc", type date},
				        {"data_fim_cc", type date},
				        {"id_local", Int64.Type},
				        {"data_inicio_local", type date},
				        {"data_fim_local", type date}
				    },
				
				    // ============================================================
				    // 3. Mantém apenas colunas que realmente existem na fonte
				    // ============================================================
				    TiposExistentes =
				        List.Select(
				            TiposDesejados,
				            each List.Contains(
				                Table.ColumnNames(#"Duplicatas Removidas"),
				                _{0}
				            )
				        ),
				
				    // ============================================================
				    // 4. Altera os tipos somente das colunas existentes
				    // ============================================================
				    #"Tipo Alterado" =
				        Table.TransformColumnTypes(
				            #"Duplicatas Removidas",
				            TiposExistentes
				        ),
				
				    // ============================================================
				    // 5. Cria Data_admissao_real de forma segura
				    // ============================================================
				    #"Personalização Adicionada" =
				        Table.AddColumn(
				            #"Tipo Alterado",
				            "Data_admissao_real",
				            each
				                try
				                    if [data_admissao] <> null
				                        and [data_admissao] <= Date.From(DateTime.LocalNow())
				                    then [data_admissao]
				                    else null
				                otherwise null,
				            type date
				        ),
				
				    // ============================================================
				    // 6. Garantia final contra duplicidade de crachá
				    // ============================================================
				    #"Duplicatas Removidas1" =
