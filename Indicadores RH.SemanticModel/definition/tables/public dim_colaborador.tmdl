	measure 3Admissões = ```
			
			VAR DataInicial = 
			    MIN('public.dCalendario'[Date]) 
			 
			VAR DataFinal = 
			    MAX('public.dCalendario'[Date]) 
			 
			RETURN 
			CALCULATE( 
			    DISTINCTCOUNT('public dim_colaborador'[sk_colaborador]), 
			 
			    REMOVEFILTERS('public.dCalendario'), 
			 
			    FILTER( 
			        'public dim_colaborador',
			
			        'public dim_colaborador'[data_admissao] >= DataInicial 
			            &&
			        'public dim_colaborador'[data_admissao] <= DataFinal
			
			            &&
			
			        NOT(
			            'public dim_colaborador'[demissao_real] >= DataInicial
			                &&
			            'public dim_colaborador'[demissao_real] <= DataFinal
			        )
			    ), 
			 
			    'public dim_colaborador'[id_cod_empresa] = 1, 
			    'public dim_colaborador'[id_tipo_colaborador] = 1, 
			    'public dim_colaborador'[id_tipo_contrato] = 1
			)
			```
		formatString: 0
		lineageTag: 0a8f71af-5d44-48b4-90ce-6767e95c50ed

	measure '3Turnover Mensal %' =
			
			DIVIDE(
			    [3Demissoes],
			    [4Ativos Competência],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 51db77dc-06f3-4321-865c-de805214d658

	measure '3Turnover Acumulado Ano %' =
			
			VAR MesesDoAno =
			    CALCULATETABLE(
			        VALUES('public.dCalendario'[AnoMes]),
			        DATESYTD('public.dCalendario'[Date])
			    )
			
			VAR TotalDemissoesYTD =
			    SUMX(
			        MesesDoAno,
			        CALCULATE([3Demissoes])
			    )
			
			RETURN
			DIVIDE(
			    TotalDemissoesYTD,
			    [3Ativos Competência],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 67d4aad9-a0b0-402c-96c0-ec37a5eded06

	measure '4Ativos Competência' =
			
			VAR DataFinal =
			    MAX('public.dCalendario'[Date])
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('RELATORIO_NILVANA'[sk_colaborador]),
			
			    REMOVEFILTERS(
			        'RELATORIO_NILVANA'[INICIO COMPETENCIA],
			        'RELATORIO_NILVANA'[FIM COMPENTENCIA]
			    ),
			
			    FILTER(
			        'RELATORIO_NILVANA',
			
			        'RELATORIO_NILVANA'[DATA DE ADIMISSÃO ] <= DataFinal
			
			            &&
			
			        (
			            ISBLANK('RELATORIO_NILVANA'[DATA DEMISSÃO])
			                ||
			            'RELATORIO_NILVANA'[DATA DEMISSÃO] > DataFinal
			        )
			    )
			)
		formatString: 0
		lineageTag: 45d23934-59f9-44b2-910c-7e948770ea42

	measure '4Turnover Mensal % Nilvana' =
			
			VAR Admissoes =
			    [4Admissões Nilvana]
			
			VAR Demissoes =
			    [4Demissoes Nilvana]
			
			VAR Headcount =
			    [4Saldo Final Colaboradores Nilvana]
			
			VAR MovimentacaoMedia =
			    DIVIDE(
			        Admissoes + Demissoes,
			        2
			    )
			
			RETURN
			    DIVIDE(
			        MovimentacaoMedia,
			        Headcount,
			        0
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 683b0dd2-107f-4de0-98be-8edfc7aea7b0

	measure '4Média Turnover Mensal Nilvana' =
			
			AVERAGEX(
			    VALUES('public.dCalendario'[AnoMes]),
			    [4Turnover Mensal % Nilvana]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a6a90f95-41e8-4b9b-ad93-b6052b2ccd86

