	column demissao_real =
			
			IF(
			    NOT ISBLANK('public dim_colaborador'[data_demissao]) && 'public dim_colaborador'[data_demissao] <= TODAY(),
			    'public dim_colaborador'[data_demissao],
			    BLANK()
			)
		formatString: Short Date
		lineageTag: 4ce7525c-93f8-48b0-a9e5-d098dd35bae9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Data_admissao_real
		dataType: dateTime
		formatString: Short Date
		lineageTag: 6178fa3b-56f1-4e7f-92d7-93c0ca24fc88
		summarizeBy: none
		sourceColumn: Data_admissao_real

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Unidade Agrupada' = ```
			
			SWITCH(
			    TRUE(),
			    // Hospital da Criança e Maternidade
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "CRIANÇA") || 
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "HCM"), "HOSPITAL DA CRIANÇA E MATERNIDADE",
			    
			    // Ambulatório
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "AMBULATÓRIO") || 
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "AMBULATORIO"), "AMBULATÓRIO",
			    
			    // Hemocentro
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "HEMOCENTRO"), "HEMOCENTRO",
			    
			    // Hospital Municipal
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "MUNICIPAL") || 
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "HM "), "HOSPITAL MUNICIPAL",
			    
			    // AME Fernandópolis
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "AME"), "AME FERNANDOPOLIS",
			    
			    // Lucy Montoro (Avaliando primeiro Fernandópolis para não confundir com Rio Preto)
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "LUCY") && 
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "FERNANDOPOLIS"), "LUCY MONTORO FERNANDOPOLIS",
			    
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "LUCY"), "LUCY MONTORO RIO PRETO",
			    
			    // Hospital de Base
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "BASE") || 
			    CONTAINSSTRING('public dim_colaborador'[descricao_local], "HB "), "HOSPITAL DE BASE",
			    
			    // Categoria Padrão para identificar locais que fugiram à regra
			    "OUTROS"
			)
			```
		lineageTag: f03aa571-6868-4d15-81a7-7cdcfdcb3bea
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

