table 'public dim_colaborador'
	lineageTag: 8c888e04-c674-4cc9-bc06-c1bdbf54a555

	measure 1Admissões =
			
			VAR DataInicial =
			    MIN('public.dCalendario'[Date])
			
			VAR DataFinal =
			    MAX('public.dCalendario'[Date])
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('public dim_colaborador'[sk_colaborador]),
			
			    REMOVEFILTERS('public.dCalendario'),
			
			    FILTER(
			        'public dim_colaborador',
			        'public dim_colaborador'[data_admissao] >= DataInicial
			            &&
			        'public dim_colaborador'[data_admissao] <= DataFinal
			    ),
			
			    'public dim_colaborador'[id_cod_empresa] = 1,
			    'public dim_colaborador'[id_tipo_colaborador] = 1,
			    'public dim_colaborador'[id_tipo_contrato] = 1,
			
			    'public dim_situacao'[descricao_situacao] <> "Desligado"
			)
		formatString: 0
		lineageTag: a300317d-f113-45c2-8bfc-94a81a2d4a41

	measure '1Ativos Início do Mês' = ```
			
			VAR PrimeiroDiaMes =
			    MIN('public.dCalendario'[date])
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('public dim_colaborador'[sk_colaborador]),
			    FILTER(
			        ALL('public dim_colaborador'),
			        
			        'public dim_colaborador'[data_admissao] < PrimeiroDiaMes
			        
			        &&
			        
			        (
			            ISBLANK('public dim_colaborador'[data_demissao])
			            ||
			            'public dim_colaborador'[data_demissao] >= PrimeiroDiaMes
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: 02741159-177d-44f1-93e4-7c4edcf726ee

	measure 3Demissoes =
			
			CALCULATE(
			    DISTINCTCOUNT('public dim_colaborador'[sk_colaborador]),
			
			    USERELATIONSHIP(
			        'public.dCalendario'[Date],
			        'public dim_colaborador'[demissao_real]
			    ),
			
			    'public dim_colaborador'[id_cod_empresa] = 1,
			
			    'public dim_colaborador'[id_tipo_colaborador] = 1
			)
		formatString: 0
		lineageTag: c9b4148c-2c39-4e49-b89e-bcbf4555dad1

	measure '3Ativos Competência' =
			
			VAR DataFinal =
			    MAX('public.dCalendario'[Date])
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('public dim_colaborador'[sk_colaborador]),
			
			    FILTER(
			        'public dim_colaborador',
			
			        'public dim_colaborador'[data_admissao] <= DataFinal
			
			        &&
			
			        (
			            ISBLANK('public dim_colaborador'[demissao_real])
			            ||
			            'public dim_colaborador'[demissao_real] > DataFinal
			        )
			    ),
			
			    'public dim_colaborador'[id_cod_empresa] = 1,
			
			    'public dim_colaborador'[id_tipo_colaborador] = 1
			)
		formatString: 0
		lineageTag: f70878cc-14f3-481f-95d9-8b80e7190d4f

