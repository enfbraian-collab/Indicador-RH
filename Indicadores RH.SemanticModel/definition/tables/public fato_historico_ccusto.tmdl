			    // =========================================================
			    // AMBULATÓRIO
			    // =========================================================
			    CHAVE IN {
			        "TERAPIAOCUPACIONALAMBULAT",
			        "FISIOTERAPIASUSAMBULATORIO",
			        "OTORRINOAMBULATORIO",
			        "GINECOLOGIAAMBULATORIO",
