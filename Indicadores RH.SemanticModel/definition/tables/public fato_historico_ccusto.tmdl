	column '1Instituição CC Histórico' =
			
			VAR CC =
			    UPPER(
			        TRIM(
			            'public fato_historico_ccusto'[descricao_centro_custo]
			        )
			    )
			
			VAR CHAVE =
			    'public fato_historico_ccusto'[CC Chave Limpa]
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    // =========================================================
			    // HOSPITAL MUNICIPAL
			    // =========================================================
			    CHAVE IN {
			        "HMAMBULATORIO",
			        "HMRECEPOAMBULATORIO",
			        "HMSAME",
			        "PRESTSERVHMDOMINGOMARCOLINOBRAILESJRP",
