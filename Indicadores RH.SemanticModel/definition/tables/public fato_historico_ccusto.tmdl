			    CHAVE IN {
			        "LUCYMONTOROFERNANDOPOLISSINTETICO",
			        "LUCYCONTROLADORIA",
			        "LUCYMONTORO",
			        "ALMOXARIFADOLUCYMONTOROFERNANDOPOLIS"
