			        "HMCENTRALDEMATERIALESTERELIZADO",
			        "HMCOZINHA",
			        "HMDIAGNOSTICODEIMAGEMSADT",
			        "HMPORTARIA",
			        "HMNTI",
			        "HOSPITALMUNICIPALDRMARCOLINOSINTETICO",
			        "HMIRASSOLADMINISTRACAO"
			    }, "HOSPITAL MUNICIPAL",
			
			    // =========================================================
			    // PREFEITURA MUNICIPAL
			    // =========================================================
			    CHAVE IN {
			        "POSTOJAGUARE",
			        "PRONTOSOCMUNMIRASSOL",
			        "UBSSTOANTONIO",
			        "POSTORIOPRETOI",
			        "PSF",
			        "ATENOBSICA",
			        "UPATAQDIAGNOSTICO",
